/*
  Install every secret with agenix-rekey, owned and readable as its claim
  says, generated by the generator its claim names, and copied or made from
  the secrets its claim references. Anything else about its value, such as
  a provided secret's encrypted file, is set on `age.secrets.<service>-<id>`
  itself, where a generator script overrides the claim's. Requires the
  agenix and agenix-rekey NixOS modules; `nixosModules.agenix-rekey` also
  imports `nixosModules.default`.
*/
{ config, lib, ... }:
let
  cfg = config.contracts.adapters.agenix-rekey;
  secrets = config.contracts.claimSets.secrets;

  isCopy = secret: secret.generate == null && secret.from != [ ];

  # The configuration a reference reads, or null for a node not in `nodes`.
  nodeConfigOrNull =
    reference: if reference.node == null then config else cfg.nodes.${reference.node}.config or null;

  labelOf =
    reference: if reference.node == null then reference.name else "${reference.node}:${reference.name}";

  # The claim a reference names, or null.
  claimOrNull =
    reference: (nodeConfigOrNull reference).contracts.claimSets.secrets.${reference.name} or null;

  /*
    The backend entry a reference names, or null when a check below rejects
    the reference, so the check reports it rather than a missing attribute.
    It reads the claim before the entry and does not follow a claim with
    `from` of its own, so two copies referencing each other fail their
    checks instead of recursing.
  */
  entryOrNull =
    reference:
    let
      claim = claimOrNull reference;
    in
    if claim == null || claim.from != [ ] then
      null
    else
      (nodeConfigOrNull reference).age.secrets.${reference.name} or null;

  # The entry of the one secret a copy references, or null.
  copiedEntryOrNull = secret: entryOrNull (lib.head secret.from);

  referenceAssertions =
    secret: reference:
    let
      known = nodeConfigOrNull reference != null;
      withContracts = known && nodeConfigOrNull reference ? contracts.claimSets.secrets;
      claim = claimOrNull reference;
      references = "secret `${secret.name}` references `${labelOf reference}`";
    in
    [
      {
        assertion = known;
        message = "secret `${secret.name}` references node `${toString reference.node}`, which is not in `contracts.adapters.agenix-rekey.nodes`.";
      }
      {
        assertion = !known || withContracts;
        message = "${references}, whose node imports no nixos-contracts module.";
      }
      {
        assertion = !withContracts || claim != null;
        message = "${references}, which is no secret claim of an enabled contract.";
      }
      {
        assertion = claim == null || claim.from == [ ];
        message = "${references}, which references secrets itself; reference a secret without `from`.";
      }
      {
        assertion = claim == null || claim.from != [ ] || entryOrNull reference != null;
        message = "${references}, whose node has no `nixosModules.agenix-rekey`.";
      }
    ];
in
{
  options.contracts.adapters.agenix-rekey.nodes = lib.mkOption {
    type = lib.types.lazyAttrsOf lib.types.raw;
    default = { };
    description = ''
      The nodes a secret's `from` may name, each with its evaluated
      `config`, such as nixos-cross-config's node collection.
    '';
  };

  config = {
    /*
      The script alone is a default, so an entry adding dependencies keeps
      it; the claim's `generate = null` is what removes the generator. The
      entries' names come from the claim set alone: one depending on another
      node's entries would recurse through `age.secrets`.
    */
    age.secrets = lib.mapAttrs (_: secret: {
      inherit (secret) group mode owner;
      generator = lib.mkIf (secret.generate != null) {
        script = lib.mkDefault secret.generate;
        dependencies = lib.mkIf (secret.from != [ ]) (
          lib.filter (entry: entry != null) (map entryOrNull secret.from)
        );
      };
      # A copy reads the encrypted file of the one secret it references.
      rekeyFile = lib.mkIf (isCopy secret) (lib.mkDefault (copiedEntryOrNull secret).rekeyFile or null);
    }) secrets;

    contracts = {
      kinds.secrets.backend = {
        generators = lib.attrNames config.age.generators;

        # Claims of disabled contracts have no `age.secrets` entry, so they
        # take agenix's default path, which an entry keeps unless a node
        # overrides it.
        location = name: config.age.secrets.${name}.path or "${config.age.secretsDir}/${name}";
      };

      /*
        Reads the final file, which agenix-rekey defaults from its
        `generatedSecretsDir` or `secretsDir`, and a copy from the secret it
        references, so a copy's message names that secret. A copy whose
        reference fails its check has no file either, which that check
        reports.
      */
      assertions =
        lib.mapAttrsToList (name: secret: {
          assertion = config.age.secrets.${name}.rekeyFile != null;
          message =
            if isCopy secret then
              "secret `${name}` copies `${labelOf (lib.head secret.from)}`, which has no encrypted file: give it one on its node, or set `age.secrets.${name}.rekeyFile`."
            else
              "secret `${name}` has no encrypted file: set its `age.secrets.${name}.rekeyFile`, or agenix-rekey's `age.rekey.generatedSecretsDir` when it has a generator and `age.rekey.secretsDir` when it has none.";
        }) (lib.filterAttrs (_: secret: !(isCopy secret) || copiedEntryOrNull secret != null) secrets)
        ++ lib.concatLists (
          lib.mapAttrsToList (_: secret: lib.concatMap (referenceAssertions secret) secret.from) secrets
        );
    };
  };
}
